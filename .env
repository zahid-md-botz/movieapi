# Required on Railway (generate a unique random value, 32+ characters)
ADMIN_SECRET=replace-with-a-long-random-secret-movie-api-zahid-on-railway

# Railway persistent volume mount path. Attach a volume at /app/.data.
DATA_DIR=/app/.data

# Public support contact shown on the website
SUPPORT_EMAIL=myweb615265@gmail.com

# Optional: configure only if you have a working SMTP provider
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional trusted upstream HTTP(S) proxy pool
PROXY_LIST=
