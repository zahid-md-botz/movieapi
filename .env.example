# Railway production configuration — set these in Railway Variables.
ADMIN_SECRET=replace_with_a_random_secret_at_least_32_chars
EDGE_SHARED_SECRET=replace_with_a_different_random_secret_at_least_32_chars
DATA_DIR=/app/.data
SUPPORT_EMAIL=myweb615265@gmail.com

