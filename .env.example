# Railway production variables — set these in Railway, never commit real values.
ADMIN_SECRET=replace_with_a_random_secret_at_least_32_characters
DATA_DIR=/app/.data
EDGE_SHARED_SECRET=replace_with_a_different_random_secret_at_least_32_characters
PUBLIC_BASE_URL=https://your-worker.workers.dev
DIRECT_CDN_URLS=false
SUPPORT_EMAIL=myweb615265@gmail.com

# Optional outbound proxy. Leave empty unless you have a trusted proxy.
MOVIEBOX_PROXY_URL=
PROXY_LIST=

# Optional SMTP settings for API key request emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REJECT_UNAUTHORIZED=true

# Optional private relay settings; Docker defaults are already correct.
MEDIA_RELAY_PORT=8765
PYTHON_BIN=/opt/venv/bin/python
