<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RUNFLIX — Request API Access</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        :root { --void: #050508; --panel: #0d0e14; --edge: rgba(255,255,255,0.07); --text: #cbd5e1; --muted: #475569; }
        body { font-family: 'Inter','Segoe UI',system-ui,sans-serif; background: var(--void); color: var(--text); min-height: 100vh; }

        header { position: sticky; top: 0; z-index: 50; background: rgba(5,5,8,0.92); backdrop-filter: blur(16px); border-bottom: 1px solid var(--edge); padding: 0 1.5rem; height: 56px; display: flex; align-items: center; justify-content: space-between; }
        .logo { display: flex; align-items: center; gap: 0.6rem; }
        .logo-icon { width: 30px; height: 30px; border-radius: 8px; background: linear-gradient(135deg,#8b5cf6,#6366f1); display: flex; align-items: center; justify-content: center; font-size: 12px; color: white; }
        .logo-text { font-size: 13px; font-weight: 700; color: #fff; letter-spacing: 0.04em; }
        .back-link { display: flex; align-items: center; gap: 0.4rem; font-size: 12px; color: var(--muted); text-decoration: none; transition: color 0.15s; }
        .back-link:hover { color: #fff; }

        .hero { padding: 4rem 1.5rem 2rem; text-align: center; max-width: 560px; margin: 0 auto; }
        .hero-badge { display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(139,92,246,0.1); border: 1px solid rgba(139,92,246,0.25); border-radius: 20px; padding: 0.35rem 0.9rem; font-size: 11px; color: #a78bfa; font-weight: 600; margin-bottom: 1.25rem; letter-spacing: 0.05em; text-transform: uppercase; }
        .hero h1 { font-size: clamp(26px,5vw,38px); font-weight: 900; color: #fff; line-height: 1.2; margin-bottom: 0.9rem; }
        .hero h1 span { background: linear-gradient(135deg,#a78bfa,#6366f1); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .hero p { font-size: 14px; color: var(--muted); line-height: 1.7; margin-bottom: 0.5rem; }

        .form-wrap { max-width: 540px; margin: 0 auto 4rem; padding: 0 1.5rem; }
        .form-card { background: var(--panel); border: 1px solid var(--edge); border-radius: 18px; padding: 2rem; }
        .field { margin-bottom: 1.1rem; }
        .field-label { font-size: 11px; font-weight: 600; color: var(--muted); margin-bottom: 0.35rem; letter-spacing: 0.06em; text-transform: uppercase; }
        .field-label .req { color: #a78bfa; }
        input[type="text"], input[type="email"], textarea {
            width: 100%; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.09);
            border-radius: 9px; padding: 0.65rem 0.9rem; color: #fff; font-size: 13px;
            font-family: inherit; outline: none; transition: border-color 0.15s; resize: vertical;
        }
        textarea { min-height: 100px; }
        input::placeholder, textarea::placeholder { color: var(--muted); }
        input:focus, textarea:focus { border-color: rgba(139,92,246,0.5); }

        .btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.75rem 1.5rem; border-radius: 10px; font-size: 14px; font-weight: 700; cursor: pointer; border: none; transition: all 0.2s; width: 100%; margin-top: 0.5rem; }
        .btn-violet { background: linear-gradient(135deg,#8b5cf6,#6366f1); color: #fff; }
        .btn-violet:hover { opacity: 0.9; transform: translateY(-1px); }
        .btn-violet:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
        .btn-docs { background: linear-gradient(135deg,#06b6d4,#0891b2); color: #fff; font-size: 15px; padding: 0.85rem; }
        .btn-docs:hover { opacity: 0.9; transform: translateY(-1px); }
        .btn-docs i { font-size: 16px; }

        .success-state { text-align: center; padding: 0.5rem 0 1rem; display: none; }
        .success-icon { width: 56px; height: 56px; border-radius: 50%; background: rgba(34,197,94,0.1); border: 2px solid rgba(34,197,94,0.3); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; font-size: 22px; color: #4ade80; }
        .success-title { font-size: 18px; font-weight: 800; color: #fff; margin-bottom: 0.5rem; }
        .success-desc { font-size: 13px; color: var(--muted); line-height: 1.6; margin-bottom: 1.5rem; }

        .features { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; max-width: 560px; margin: 0 auto 3rem; padding: 0 1.5rem; }
        @media(max-width:560px) { .features { grid-template-columns: 1fr; } }
        .feature { background: var(--panel); border: 1px solid var(--edge); border-radius: 12px; padding: 1.1rem; }
        .feature i { font-size: 20px; color: #a78bfa; margin-bottom: 0.5rem; display: block; }
        .feature h3 { font-size: 13px; font-weight: 700; color: #fff; margin-bottom: 0.25rem; }
        .feature p { font-size: 11px; color: var(--muted); line-height: 1.5; }

        .error-msg { font-size: 12px; color: #fca5a5; margin-top: 0.75rem; text-align: center; min-height: 18px; }
        .spinner { display: inline-block; width: 14px; height: 14px; border: 2px solid rgba(255,255,255,0.3); border-top-color: #fff; border-radius: 50%; animation: spin 0.7s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>
<body>
    <header>
        <div class="logo">
            <div class="logo-icon"><i class="fas fa-film"></i></div>
            <span class="logo-text">RUNFLIX</span>
        </div>
        <a href="/docs" class="back-link"><i class="fas fa-book-open" style="font-size:10px;"></i> <span>View Docs</span></a>
    </header>

    <div class="hero">
        <div class="hero-badge"><i class="fas fa-key"></i> API Access</div>
        <h1>Get your <span>RUNFLIX API</span> key</h1>
        <p>Fill in the form below and we'll review your request. You'll receive your API key directly.</p>
    </div>

    <div class="features">
        <div class="feature">
            <i class="fas fa-bolt"></i>
            <h3>Fast Responses</h3>
            <p>Real-time movie &amp; TV data with low latency.</p>
        </div>
        <div class="feature">
            <i class="fas fa-layer-group"></i>
            <h3>Rich Data</h3>
            <p>Streaming sources, captions, metadata &amp; more.</p>
        </div>
        <div class="feature">
            <i class="fas fa-shield-alt"></i>
            <h3>Reliable</h3>
            <p>Cloudflare-hosted, always-on global edge.</p>
        </div>
    </div>

    <div class="form-wrap">
        <div class="form-card">
            <div id="formState">
                <div class="field">
                    <div class="field-label">Your Name <span class="req">*</span></div>
                    <input type="text" id="fName" placeholder="e.g. John Kamau" autocomplete="name">
                </div>
                <div class="field">
                    <div class="field-label">Email Address</div>
                    <input type="email" id="fEmail" placeholder="you@example.com" autocomplete="email">
                </div>
                <div class="field">
                    <div class="field-label">Website or App URL</div>
                    <input type="text" id="fWebsite" placeholder="https://myapp.com" autocomplete="url">
                </div>
                <div class="field">
                    <div class="field-label">How will you use it? <span class="req">*</span></div>
                    <textarea id="fUseCase" placeholder="e.g. Building a movie discovery app for Android users in Kenya. I need info, sources and captions endpoints."></textarea>
                </div>
                <button class="btn btn-violet" id="submitBtn" onclick="submitRequest()">
                    <i class="fas fa-paper-plane"></i> Submit Request
                </button>
                <div class="error-msg" id="errMsg"></div>
            </div>

            <div class="success-state" id="successState">
                <div class="success-icon"><i class="fas fa-check"></i></div>
                <div class="success-title">Request Submitted!</div>
                <div class="success-desc" id="successDesc">Your request has been received and emailed to our team. We'll review it and send your API key to the email address you provided.</div>
                <a href="/docs" class="btn btn-docs">
                    <i class="fas fa-book-open"></i> Explore the Documentation
                </a>
                <a href="/try" class="btn" style="background:transparent;border:1px solid rgba(255,255,255,0.09);color:var(--muted);margin-top:0.5rem;">
                    <i class="fas fa-flask"></i> Try Free Search Playground
                </a>
            </div>
        </div>
    </div>

    <script>
        async function submitRequest() {
            const name = document.getElementById('fName').value.trim();
            const email = document.getElementById('fEmail').value.trim();
            const website = document.getElementById('fWebsite').value.trim();
            const useCase = document.getElementById('fUseCase').value.trim();
            const errEl = document.getElementById('errMsg');
            errEl.textContent = '';

            if (!name) return (errEl.textContent = 'Please enter your name.');
            if (!useCase) return (errEl.textContent = 'Please describe your use case.');

            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner"></span> Submitting…';

            try {
                const r = await fetch('/api/request-key', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, email, website, useCase })
                });
                const d = await r.json();
                if (!r.ok) {
                    errEl.textContent = d.error || 'Something went wrong.';
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-paper-plane"></i> Submit Request';
                    return;
                }
                document.getElementById('formState').style.display = 'none';
                document.getElementById('successState').style.display = 'block';
                if (email) {
                    document.getElementById('successDesc').textContent = `Your request has been emailed to our team. We'll review it and send your API key to ${email}.`;
                }
            } catch {
                errEl.textContent = 'Network error — please try again.';
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-paper-plane"></i> Submit Request';
            }
        }

        document.addEventListener('keydown', e => {
            if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') submitRequest();
        });
    </script>
</body>
</html>
