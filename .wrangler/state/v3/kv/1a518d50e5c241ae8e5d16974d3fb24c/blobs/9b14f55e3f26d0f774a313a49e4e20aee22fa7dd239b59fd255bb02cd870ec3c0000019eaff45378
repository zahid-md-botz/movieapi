            padding: 0.75rem 0;
            font-size: 0.875rem;
            font-weight: 600;
            color: #e2e8f0;
            border-bottom: 1px solid #1a2035;
            cursor: pointer;
        }

        .mobile-dropdown-items {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
            padding-left: 1.5rem;
        }
        .mobile-dropdown-items.open {
            max-height: 300px;
        }

        .mobile-dropdown-items .mobile-link {
            font-size: 0.8125rem;
            padding: 0.625rem 0;
            border-bottom: none;
        }

        /* Floating quick-nav for desktop */
        .quick-nav {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            z-index: 40;
            background: #111827;
            border: 1px solid #1a2035;
            border-radius: 1rem;
            padding: 0.75rem;
            box-shadow: 0 20px 40px rgba(0,0,0,0.5);
            display: none;
        }
