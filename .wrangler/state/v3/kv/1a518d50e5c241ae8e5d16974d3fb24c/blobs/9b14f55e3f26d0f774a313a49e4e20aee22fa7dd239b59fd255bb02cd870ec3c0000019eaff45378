            top: 100%;
            left: 0;
            right: 0;
            background: #0a0f1e;
            border-bottom: 1px solid #1a2035;
            padding: 1rem 1.5rem;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px);
            transition: all 0.25s ease;
            z-index: 40;
            max-height: 0;
            overflow: hidden;
        }
        .mobile-panel.open {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
            max-height: 500px;
            overflow: visible;
        }

