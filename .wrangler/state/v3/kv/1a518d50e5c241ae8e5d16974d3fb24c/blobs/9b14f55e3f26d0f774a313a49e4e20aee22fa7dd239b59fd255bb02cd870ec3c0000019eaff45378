            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 0;
            font-size: 0.875rem;
            font-weight: 500;
            color: #94a3b8;
            border-bottom: 1px solid #1a2035;
            transition: color 0.15s;
        }
        .mobile-link:last-child {
            border-bottom: none;
        }
        .mobile-link:hover, .mobile-link.active {
