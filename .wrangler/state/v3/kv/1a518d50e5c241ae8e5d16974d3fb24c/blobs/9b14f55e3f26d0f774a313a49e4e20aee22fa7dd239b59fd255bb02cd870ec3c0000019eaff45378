        }

        .method-badge {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            padding: 0.25rem 0.5rem;
            border-radius: 0.375rem;
            border: 1px solid;
        }
        .method-get {
            background: rgba(34,211,238,0.08);
            color: #22d3ee;
            border-color: rgba(34,211,238,0.2);
        }

        .code-window {
            background: #0d1117;
            border: 1px solid #1a2035;
            border-radius: 10px;
            overflow: hidden;
        }
        .code-tab-bar {
            display: flex;
            gap: 0.25rem;
            margin-bottom: 0.5rem;
        }
        .code-tab-btn {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.65rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 0.25rem 0.8rem;
            border-radius: 9999px;
            border: 1px solid #1a2035;
            background: #0a0f1e;
            color: #64748b;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .code-tab-btn:hover {
            color: #cbd5e1;
            border-color: #25304a;
        }
        .code-tab-btn.active {
            background: rgba(34,211,238,0.1);
            border-color: rgba(34,211,238,0.3);
            color: #22d3ee;
        }
        .code-tab-panel.hidden { display: none; }

        .code-window { position: relative; }
        .copy-btn {
            position: absolute;
            top: 9px;
            right: 10px;
            background: #0a0f1e;
            border: 1px solid #1a2035;
            border-radius: 6px;
            color: #64748b;
            padding: 3px 9px;
            font-size: 11px;
            cursor: pointer;
            transition: all 0.15s ease;
            font-family: 'JetBrains Mono', monospace;
            letter-spacing: 0.04em;
            display: flex;
            align-items: center;
            gap: 4px;
            z-index: 1;
        }
        .copy-btn:hover { color: #cbd5e1; border-color: #25304a; }
        .copy-btn.copied { color: #34d399; border-color: rgba(52,211,153,0.3); background: rgba(52,211,153,0.06); }

        .code-window-header {
            background: #111827;
            border-bottom: 1px solid #1a2035;
            padding: 10px 14px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .dot { width: 10px; height: 10px; border-radius: 50%; }
        .dot-red { background: #f87171; }
        .dot-yellow { background: #fbbf24; }
        .dot-green { background: #34d399; }

        .param-table {
            width: 100%;
            font-size: 0.8125rem;
            border-collapse: collapse;
        }
        .param-table th {
            text-align: left;
            padding: 0.625rem 1rem;
            font-size: 0.65rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #64748b;
            background: rgba(255,255,255,0.02);
            border-bottom: 1px solid #1a2035;
        }
        .param-table td {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid #1a2035;
            color: #94a3b8;
        }
        .param-table tr:last-child td {
            border-bottom: none;
        }

        .scroll-indicator {
            position: fixed;
            top: 0;
            left: 0;
            height: 2px;
            background: linear-gradient(90deg, #22d3ee, #a78bfa);
            z-index: 100;
            width: 0%;
            transition: width 0.1s;
