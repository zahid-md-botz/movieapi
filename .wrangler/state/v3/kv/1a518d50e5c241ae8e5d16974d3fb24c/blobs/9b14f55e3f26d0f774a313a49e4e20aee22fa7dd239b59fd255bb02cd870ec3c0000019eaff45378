            border-radius: 0.5rem;
            font-size: 0.75rem;
            color: #64748b;
            transition: all 0.15s;
            white-space: nowrap;
        }
        .quick-nav-link:hover, .quick-nav-link.active {
            color: #22d3ee;
            background: rgba(34,211,238,0.04);
        }
    </style>
