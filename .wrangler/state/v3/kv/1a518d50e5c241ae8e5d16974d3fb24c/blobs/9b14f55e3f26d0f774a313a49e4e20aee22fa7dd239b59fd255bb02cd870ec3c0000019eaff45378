        .dropdown-menu.open {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .dropdown-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.625rem 0.875rem;
            border-radius: 0.5rem;
            font-size: 0.8125rem;
            color: #94a3b8;
            transition: all 0.15s ease;
        }
        .dropdown-item:hover {
            background: rgba(34,211,238,0.04);
            color: #e2e8f0;
        }

        /* Mobile dropdown panel */
        .mobile-panel {
